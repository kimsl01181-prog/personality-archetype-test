[
  {
    "id": "q01",
    "text": "사람들과 실컷 떠들고 오면 기운이 난다.",
    "dimension": "X",
    "reverse": false,
    "ipipFacet": "Sociability"
  },
  {
    "id": "q02",
    "text": "서운했던 사람과도 금방 예전처럼 지내게 된다.",
    "dimension": "A",
    "reverse": false,
    "ipipFacet": "Forgiveness"
  },
  {
    "id": "q03",
    "text": "여행 가기 전에 일정을 시간대별로 짜 두는 편이다.",
    "dimension": "C",
    "reverse": false,
    "ipipFacet": "Organization"
  },
  {
    "id": "q04",
    "text": "슬픈 영화를 보면 눈물이 쉽게 난다.",
    "dimension": "E",
    "reverse": false,
    "ipipFacet": "Sentimentality"
  },
  {
    "id": "q05",
    "text": "전시회나 공연을 일부러 찾아가서 보는 편이다.",
    "dimension": "O",
    "reverse": false,
    "ipipFacet": "Aesthetic Appreciation"
  },
  {
    "id": "q06",
    "text": "쓸 만하기만 하면 비싼 브랜드가 아니어도 괜찮다.",
    "dimension": "H",
    "reverse": false,
    "ipipFacet": "Greed Avoidance"
  },
  {
    "id": "q07",
    "text": "식당에 가면 늘 먹던 메뉴를 시키는 편이다.",
    "dimension": "O",
    "reverse": true,
    "ipipFacet": "Unconventionality"
  },
  {
    "id": "q08",
    "text": "중요한 일을 앞두면 이것저것 미리 걱정이 된다.",
    "dimension": "E",
    "reverse": false,
    "ipipFacet": "Anxiety"
  },
  {
    "id": "q09",
    "text": "아무도 모를 일이라도 정해진 규칙대로 하는 게 편하다.",
    "dimension": "H",
    "reverse": false,
    "ipipFacet": "Fairness"
  },
  {
    "id": "q10",
    "text": "마감이 닥쳐야 비로소 일에 속도가 붙는다.",
    "dimension": "C",
    "reverse": true,
    "ipipFacet": "Diligence"
  },
  {
    "id": "q11",
    "text": "약속 없는 주말엔 오히려 마음이 편하다.",
    "dimension": "X",
    "reverse": true,
    "ipipFacet": "Sociability"
  },
  {
    "id": "q12",
    "text": "의견이 부딪히면 내가 먼저 한발 물러서는 편이다.",
    "dimension": "A",
    "reverse": false,
    "ipipFacet": "Flexibility"
  },
  {
    "id": "q13",
    "text": "무언가를 보내기 전에 오타가 없는지 몇 번씩 확인한다.",
    "dimension": "C",
    "reverse": false,
    "ipipFacet": "Perfectionism"
  },
  {
    "id": "q14",
    "text": "내가 잘한 일은 사람들이 알아줬으면 좋겠다.",
    "dimension": "H",
    "reverse": true,
    "ipipFacet": "Modesty"
  },
  {
    "id": "q15",
    "text": "상대가 틀렸다 싶으면 그 자리에서 바로 짚고 넘어간다.",
